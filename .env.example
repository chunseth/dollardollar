# A Postgres connection string. The database user needs permission to create tables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Server-only. Never put this in browser code or a client-side environment variable.
OPENAI_API_KEY=your_openai_api_key
# Optional model override for onboarding drafts.
OPENAI_MODEL=gpt-5.5
# Optional outbound API timeout for onboarding drafts (milliseconds).
ONBOARDING_TIMEOUT_MS=90000
# Bound response size for the fast profile/assumption draft and the later plan.
ONBOARDING_DRAFT_MAX_OUTPUT_TOKENS=1800
ONBOARDING_PLAN_MAX_OUTPUT_TOKENS=2400
# Set only when your provider requires TLS.
# DATABASE_SSL=true
